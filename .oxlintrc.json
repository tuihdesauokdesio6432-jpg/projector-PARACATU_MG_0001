{
  "ignorePatterns": [
    "**/build/**",
    "**/public/donainel/**",
    "**/public/donaspainel/**",
    "**/node_modules/**",
    "frontend/build",
    "frontend/build/**",
    "frontend/public/donainel",
    "frontend/public/donainel/**",
    "frontend/public/donaspainel",
    "frontend/public/donaspainel/**",
    "frontend/node_modules"
  ],
  "globals": {
    "WorkerGlobalScope": "readonly",
    "__REACT_DEVTOOLS_GLOBAL_HOOK__": "readonly",
    "IdecanNotice": "readonly"
  },
  "rules": {
    "no-undef": "off"
  }
}
